{
  "name": "yueji-mall-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "contract:lint": "redocly lint ../contracts/openapi.json --config ../redocly.yaml"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.70.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
