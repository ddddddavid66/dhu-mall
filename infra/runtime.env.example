# Copy to a restricted file outside the repository (for example /opt/yueji/runtime.env).
# Keep permissions at 0600. Values below are non-secret examples; never commit the copy.
APP_HOSTNAME=replace-with-test-host.example.invalid
APP_BASE_URL=https://replace-with-test-host.example.invalid
DEPLOY_ENV=test
ALLOWED_ORIGINS=https://replace-with-test-host.example.invalid
MYSQL_DATABASE=yueji_mall_test
DB_USERNAME=yueji_app
BACKEND_IMAGE=ghcr.io/replace-owner/replace-repository/backend@sha256:replace-before-use
FRONTEND_IMAGE=ghcr.io/replace-owner/replace-repository/frontend@sha256:replace-before-use
IMAGE_REPOSITORY=ghcr.io/replace-owner/replace-repository
PAYMENT_PROVIDER=ALIPAY_SANDBOX
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=replace-with-sandbox-app-id
ALIPAY_SELLER_ID=replace-with-sandbox-seller-id
ALIPAY_NOTIFY_URL=https://replace-with-test-host.example.invalid/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://replace-with-test-host.example.invalid/payment/result
FILE_STORAGE_PATH=/opt/yueji/data/files
TLS_CERTIFICATE_PATH=/opt/yueji/tls
MYSQL_ROOT_PASSWORD_FILE=/opt/yueji/secrets/mysql-root-password
DB_PASSWORD_FILE=/opt/yueji/secrets/database-password
JWT_SIGNING_KEY_FILE=/opt/yueji/secrets/jwt-signing-key
ALIPAY_APP_PRIVATE_KEY_FILE=/opt/yueji/secrets/alipay-sandbox-private-key
ALIPAY_PUBLIC_KEY_FILE=/opt/yueji/secrets/alipay-sandbox-public-key
GRAFANA_ADMIN_PASSWORD=
BACKUP_DIRECTORY=/opt/yueji/backups
BACKUP_AGE_RECIPIENT=age1replace-with-operator-public-recipient
BACKUP_REMOTE=operator-configured-remote:yueji-test
RCLONE_CONFIG_FILE=/opt/yueji/secrets/rclone.conf
AGE_IDENTITY_FILE=/opt/yueji/secrets/backup-age-identity
RESTORE_DATABASE=yueji_mall_restore_20261026
RESTORE_FILE_STORAGE_PATH=/opt/yueji/restore/files-20261026
YUEJI_ALLOW_APP_ROLLBACK=false
